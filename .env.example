# ── PostgreSQL ───────────────────────────────────────────
POSTGRES_USER=aiops
POSTGRES_PASSWORD=change_me_in_dot_env
POSTGRES_DB=aiops

# ── API ──────────────────────────────────────────────────
DATABASE_URL=postgresql://aiops:change_me_in_dot_env@db:5432/aiops

# ── Registry ─────────────────────────────────────────────
# Set these to match your environment.
# Local dev:    SENTINEL_URL=http://localhost:8000
# Docker:       SENTINEL_URL=http://sentinel:8000
SENTINEL_URL=http://localhost:8000
ENV_NAME=development
SENTINEL_LOGS_DIR=D:/path/to/sentinel/logs
